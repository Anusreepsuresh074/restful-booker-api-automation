# Copy to .env and fill in real values locally — never commit the real .env.

# Auth — resolved by get-api-auth (see context/api-auth.md). This API has one fixed, published
# demo credential pair (no account creation, no secrets in the usual sense) — still sourced from
# env rather than hardcoded in test/fixture code.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=password123

# Optional overrides of config.yaml's per-environment values
# BASE_URL=
# TIMEOUT=
